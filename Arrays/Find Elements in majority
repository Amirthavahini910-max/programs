import java.util.*;
import java.lang.*;
class Main {
    public static void main(String[] args) {
      Scanner scan=new Scanner(System.in);
      System.out.println("Enter the size");
      int n=scan.nextInt();
      System.out.println("Enter the elements");
      int[] nums=new int[n];
      for(int i=0;i<n;i++)
      {
          nums[i]=scan.nextInt();
      }
      findMajority(nums,n);
    }
    public static void findMajority(int[] nums,int n)
    {
      int count=0;
      int max=0;
      int max2=0;
      int mid=n/2;
      for(int i=0;i<n-1;i++)
      {
          count=0;
          for(int j=i+1;j<n;j++)
          {
              if(nums[i]==nums[j]&&i!=j)
              {
                  count++;
              }
          }
          if(max<count)
          {
              max=count;
              max2=nums[i];
              
          }
      }
      System.out.println(max2);
     
       
    }
}
