import java.lang.*;
import java.util.*;
class Main{
    public static void main(String str[])
    {
        Scanner scan=new Scanner(System.in);
        System.out.println("Enter the size:");
        int n=scan.nextInt();
        System.out.println("Enter the elemenst:");
        int[] arr=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=scan.nextInt();
        }
        finddupandmissing(arr,n);
        
    }
    public static void finddupandmissing(int[] arr,int n)
    {
        int dup=0;
        int sum=0;
        for(int i=0;i<n-1;i++)
        {
            sum+=arr[i];
            for(int j=i+1;j<n;j++)
            {
                if(arr[i]==arr[j] && i!=j)
                {
                    dup=arr[i];
                }
            }
        }
        sum=sum+arr[n-1];
        System.out.println("The duplicate number is");
        sum=sum-dup;
        
        System.out.println(dup);
        int mis=(n*(n+1))/2;
         System.out.println("The missing number is");
        mis=mis-sum;
        System.out.println(mis);
        
        
    }
}
