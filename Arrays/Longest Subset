import java.util.*;
import java.lang.*;
class Main {
    public static void main(String[] args) {
      Scanner scan=new Scanner(System.in);
      System.out.println("Enter the size");
      int n=scan.nextInt();
      System.out.println("Enter the target");
      int target=scan.nextInt();
      System.out.println("Enter the elements");
      int[] nums=new int[n];
      for(int i=0;i<n;i++)
      {
          nums[i]=scan.nextInt();
      }
      longSubset(nums,n,target);
    }
    public static void longSubset(int[] nums,int n,int target)
    {
        int count=0,sum=0,max=0,sum2=0;
        for(int i=0;i<n;i++)
        {
            sum=0;
            count=0;
            for(int j=i;j<n;j++)
            {
                if(target>sum+nums[j])
                {
                    sum+=nums[i];
                    count++;
                }
                else if(target==sum+nums[j]){
                     sum=sum+nums[j];
                     sum2=sum;
                     count++;
                }
                else
                {
                   
                    break;
                    
                }
            }
            if(max<count &&sum2==target){
                max=count;
            }
            
        }
        System.out.println(max);
    }
}
