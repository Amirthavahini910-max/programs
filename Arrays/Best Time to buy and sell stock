import java.lang.*;
import java.util.*;

class Main {
    public static void main(String[] args) {
    Scanner scan=new Scanner(System.in);
    System.out.println("Enter the size");
    int n=scan.nextInt();
     System.out.println("Enter elements:");
    int[] nums=new int[n];
    for(int i=0;i<n;i++)
    {
        nums[i]=scan.nextInt();
    }
    findProfit(nums,n);
    }
    public static void findProfit(int[] nums,int n)
    {
        int max=0,min=9999999;
        int mid=n/2;
        for(int i=0;i<mid;i++)
        {
            if(min>nums[i])
            {
                min=nums[i];
            }
            
        }
          for(int i=mid;i<n;i++)
        {
            if(max<nums[i])
            {
                max=nums[i];
            }
            
        }
        mid=max-min;
        if(mid>0){
        
            System.out.println(mid);
        }
        else{
            System.out.println("0");
        }
    }
}
