    public static void findMissing(int[] nums1,int n1,int[] nums2,int n2, int[] nums3, int n3)
    {
       int i=0,j=0,k=0;
       int temp1=n1,temp2=n2,temp=n3;
       while(n1>0 && n2>0)
       {
           if(nums1[i]>nums2[j])
           {
              nums3[k++]=nums2[j++]; 
              n2--;
           }
           else if(nums1[i]<nums2[j])
           {
                nums3[k++]=nums1[i++]; 
                n1--;
           }
           else{
               nums3[k++]=nums1[i++];
               j++;
               n1--;
               n2--;
           }
       }
       int temp4=k;
       if(n2==0)
       {
           for(int a=temp4;a<temp4+n1;a++)
           {
               nums3[k++]=nums1[i++];
           }
       }
       else{
           
           for(int a=temp4;a<temp4+n2;a++)
           {
               nums3[k++]=nums2[j++];
           }
       
       }
       for(int l=0;l<k;l++)
       {
           System.out.println(nums3[l]);
       }
           
    }
