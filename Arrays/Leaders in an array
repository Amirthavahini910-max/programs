import java.lang.*;
import java.util.*;

class Main {
    public static void main(String[] args) {
    Scanner scan=new Scanner(System.in);
    System.out.println("Enter the size");
    int n=scan.nextInt();
     System.out.println("Enter elements:");
    int[] nums=new int[n];
    for(int i=0;i<n;i++)
    {
        nums[i]=scan.nextInt();
    }
    int[] nums2=new int[n];
    findLeader(nums,n,nums2);
    }
    public static void findLeader(int[] nums,int n,int[] nums2)
    {
        int k=0;
        for(int i=0;i<n-1;i++)
        {
            if(nums[i+1]<nums[i])
            {
              nums2[k++]=nums[i];  
            }
        }
        nums2[k++]=nums[n-1];
        for(int i=0;i<k;i++)
        {
            System.out.print(nums2[i]+" ");
        }
        
    }
}
