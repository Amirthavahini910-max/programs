import java.lang.*;
import java.util.*;

class Main {
    public static void main(String[] args) {
      Scanner scan=new Scanner(System.in);
      System.out.println("Enter the size");
      int n=scan.nextInt();
      System.out.println("Enter the elements");
      int[] nums=new int[n];
        for(int i=0;i<n;i++)
      {
          nums[i]=scan.nextInt();
      }
      findMaxConsecutives(nums,n);
      
    }
    public static void findMaxConsecutives(int[] nums,int n)
    {
        int count=0, max=0;
      for(int i=0;i<n;i++)
      {
          if(nums[i]==1)
          {
              count++;
              if(i==n-1)
              {
             if(max<count)
              {
              max=count;
              }
              }
          }
          else
          {
              if(max<count)
              {
              max=count;
              }
              count=0;
          }
         
      }
       System.out.println(max);
    }
}
